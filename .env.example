# ===== microCMS (News & Topics) =====
# Sign up at https://microcms.io/ and create a service.
# Then create an API: endpoint name "news" with these fields:
#   slug          (text, required, unique)
#   category      (select: announcement | event | press)
#   publishedAt   (datetime)
#   title_ja      (text, required)
#   title_zh      (text, optional)
#   title_en      (text, optional)
#   title_ne      (text, optional)
#   content_ja    (rich editor V2, required)
#   content_zh    (rich editor V2, optional)
#   content_en    (rich editor V2, optional)
#   content_ne    (rich editor V2, optional)
#   thumbnail     (image, optional)
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# ===== Resend (Inquiry form mailer) =====
# Sign up at https://resend.com/ — free tier covers 3,000 emails/month.
# Verify your sending domain (hirai-gakuen.ac.jp) under "Domains".
RESEND_API_KEY=
# Verified sender — must be on your verified Resend domain.
RESEND_FROM_EMAIL=noreply@hirai-gakuen.ac.jp
# Inquiry recipient is hardcoded to info03@hirai-gakuen.ac.jp in
# src/lib/contact-action.ts; there is no env var for it.
